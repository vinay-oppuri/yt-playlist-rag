# ── LLM Provider ────────────────────────────────────────────────────────
# Supported values: ollama, openai, gemini
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b

# ── Ollama (local, OpenAI-compatible) ───────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── OpenAI ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Google Gemini ───────────────────────────────────────────────────────
# Get yours at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Qdrant Vector Store ────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=yt_transcripts

# ── Reranker ────────────────────────────────────────────────────────────
# Local cross-encoder reranking. The small model downloads on first search.
# Set to "none" to disable and use reciprocal rank fusion only.
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# ── Durable playlist indexing queue ─────────────────────────────────────
INGESTION_DB_PATH=data/ingestion_jobs.sqlite3
INGESTION_MAX_ATTEMPTS=3
INGESTION_WORKER_LEASE_SECONDS=30

# ── CORS ────────────────────────────────────────────────────────────────
# Production CORS origin — leave blank for localhost-only development
# Example: CORS_ORIGIN=https://your-app.vercel.app
CORS_ORIGIN=
